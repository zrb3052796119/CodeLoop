# CodeLoop 同学交付：最小主模型配置。
# 放到用户目录 ~/.mini-code/.env；不要覆盖已有配置，不要提交真实 Key。
# 用编辑器填入模型服务控制台给出的准确值；本模板不绑定任何付费服务。
# 初始空值故意不能通过真实模型配置校验。
MINI_CODE_PROVIDER=custom
MINI_CODE_MODEL=
CUSTOM_API_BASE_URL=
CUSTOM_API_KEY=

# 回复偏好
MINI_CODE_LANGUAGE=zh-CN
MINI_CODE_VERBOSITY=normal

# 首次试用的单轮预算：父 Agent 与子 Agent 共用。
# 复杂任务可能触及上限；成本是本地估计，不是 provider 账单限额。
MINI_CODE_TURN_BUDGET_TOKENS=200000
MINI_CODE_TURN_BUDGET_MODEL_CALLS=20
MINI_CODE_TURN_BUDGET_COST_USD=1

# 首次试用保持语义意图/Hybrid/远程 embedding 增强关闭。
MINI_CODE_INTENT_SEMANTIC_ENABLED=false
MINI_CODE_MEMORY_HYBRID_ENABLED=false
MINI_CODE_ALLOW_REMOTE_MEMORY_EMBEDDING=false
MINICODE_EMBEDDING_API_KEY=
MINI_CODE_SUBAGENT_API_KEY=
# 留空表示子 Agent 复用主模型，并不关闭子 Agent 或它的模型调用。

# MINI_CODE_MODEL_MODE=mock 不写入此文件；仅在终端临时设置。
# 若用 Anthropic/OpenAI/OpenRouter 原生配置，可改用 --install 向导。
