# =============================================================================
# MiniCode Python — Environment Variables
# =============================================================================
# Copy this to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Required (at least one API key) ---
# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Or use auth token instead:
# ANTHROPIC_AUTH_TOKEN=

# OpenAI
# OPENAI_API_KEY=sk-...

# OpenRouter (access to 200+ models)
# OPENROUTER_API_KEY=sk-or-...

# Custom OpenAI-compatible endpoint (vLLM, Ollama, LiteLLM, etc.)
# CUSTOM_API_KEY=...
# CUSTOM_API_BASE_URL=http://localhost:11434/v1

# --- Model ---
# Anthropic models
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI models (set this to use GPT models):
# ANTHROPIC_MODEL=gpt-4o

# OpenRouter models (set OPENROUTER_API_KEY first):
# ANTHROPIC_MODEL=anthropic/claude-sonnet-4
# ANTHROPIC_MODEL=openai/gpt-4o
# ANTHROPIC_MODEL=google/gemini-2.5-pro
# ANTHROPIC_MODEL=deepseek/deepseek-r1
# ANTHROPIC_MODEL=meta-llama/llama-4-maverick
# ANTHROPIC_MODEL=openrouter/auto

# Custom endpoint models:
# ANTHROPIC_MODEL=my-custom-model
# CUSTOM_API_BASE_URL=http://localhost:11434/v1

# --- Logging ---
MINI_CODE_LOG_LEVEL=WARNING
# Options: DEBUG, INFO, WARNING, ERROR

# --- Workspace (for Docker) ---
MINI_CODE_WORKSPACE=.

# --- Gateway mode ---
# MINI_CODE_GATEWAY=1
MINI_CODE_GATEWAY_PORT=8080
MINI_CODE_GATEWAY_HOST=0.0.0.0

# --- Platform tokens (for gateway multi-platform) ---
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=

# --- Cron ---
# MINI_CODE_CRON_CONFIG=./.mini-code/cron.json

# --- OpenRouter settings ---
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# OPENROUTER_REFERER=https://github.com/minicode-py
# OPENROUTER_TITLE=MiniCode Python
# OPENROUTER_TRANSFORMS=

# --- Custom endpoint settings ---
# CUSTOM_API_BASE_URL=http://localhost:11434/v1
# CUSTOM_API_KEY=
# CUSTOM_API_EXTRA_HEADERS=X-Custom-Header:value

# --- Skill semantic routing (embedding) ---
# 语义技能路由的 embedding 配置。默认指向 Qwen/DashScope compatible-mode，
# 任何 OpenAI 兼容的 /embeddings 端点都可用。
# 留空 MINICODE_EMBEDDING_API_KEY 即关闭（本地中英别名匹配仍然工作）。
# 读取顺序：进程环境变量 > <workspace>/.env > ~/.mini-code/.env > 默认值。
MINICODE_EMBEDDING_API_KEY=
MINICODE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen embedding 模型：text-embedding-v3 / text-embedding-v4
MINICODE_EMBEDDING_MODEL=text-embedding-v3
# MINICODE_EMBEDDING_TIMEOUT_SECONDS=10
# 相似度阈值（已按 Qwen text-embedding-v3 实测校准：相关 0.63-0.84，无关 <=0.48）。
# 换其他 embedding provider 时按其分布调整。
# MINICODE_EMBEDDING_SIGNAL_THRESHOLD=0.60
# MINICODE_EMBEDDING_SIGNAL_THRESHOLD_UNKNOWN=0.67
# MINICODE_EMBEDDING_BOOST_THRESHOLD=0.52

# --- Evidence-gated Hybrid Memory retrieval ---
# Disabled by default. local-e5 keeps query/memory embeddings on-device;
# qwen reuses the Skill embedding endpoint but requires a separate explicit
# authorization because approved persistent memories leave the machine.
# MINI_CODE_MEMORY_HYBRID_ENABLED=false
# MINI_CODE_MEMORY_HYBRID_EMBEDDING_PROVIDER=local-e5
# MINI_CODE_ALLOW_REMOTE_MEMORY_EMBEDDING=false
# MINI_CODE_MEMORY_HYBRID_MODEL_PATH=/absolute/path/to/multilingual-e5-small
# MINI_CODE_MEMORY_HYBRID_EVIDENCE_PATH=/absolute/path/to/promotion-evidence.json
# MINI_CODE_MEMORY_HYBRID_VERIFIER_MODEL=deepseek-chat

# --- Bounded Skill evidence feedback ---
# Enabled by default. Strong digest/profile-bound historical evidence may
# reorder already-relevant Skill candidates by at most +/-0.25; it can never
# break abstention or promote a Skill version. Set to 0 for immediate rollback.
# MINICODE_SKILL_FEEDBACK=0

# --- User Profile ---
# Set response language and verbosity (also configurable via USER.md)
# MINI_CODE_LANGUAGE=zh-CN
# MINI_CODE_VERBOSITY=normal
# Options for VERBOSITY: concise, normal, detailed
# Create ~/.mini-code/USER.md for full profile customization

# --- Shared Agent Turn budget (top-level + all task sub-agents) ---
# The same token/model-call/cost counters are shared by the parent loop and
# every nested explore/plan/general sub-agent, including parallel read-only
# sub-agents. Model-call budget defaults to 80 when no value is configured.
# MINI_CODE_TURN_BUDGET_TOKENS=2000000
# MINI_CODE_TURN_BUDGET_MODEL_CALLS=80
# MINI_CODE_TURN_BUDGET_COST_USD=20

# --- Dedicated per-agent model routing ---
# Fill only this key to route task sub-agents to DashScope Qwen automatically.
# When it is empty, sub-agents keep using the parent model for compatibility.
# The credential is deliberately separate from parent and embedding API keys.
MINI_CODE_SUBAGENT_API_KEY=
MINI_CODE_SUBAGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MINI_CODE_SUBAGENT_MODEL=qwen3.6-flash
# Optional explicit switch and per-agent overrides:
# MINI_CODE_SUBAGENT_ROUTING_ENABLED=true
# MINI_CODE_SUBAGENT_PROVIDER=openai-compatible
# MINI_CODE_SUBAGENT_EXPLORE_MODEL=qwen3.6-flash
# MINI_CODE_SUBAGENT_PLAN_MODEL=qwen3.6-flash
# MINI_CODE_SUBAGENT_GENERAL_MODEL=qwen3.6-flash
