# =============================================================================
# CodeLoop (package: minicode-py) — Environment Variables
# =============================================================================
# Copy this to the global CodeLoop config directory and fill in your values:
#   mkdir -p ~/.mini-code
#   chmod 700 ~/.mini-code
#   cp .env.example ~/.mini-code/.env
#   chmod 600 ~/.mini-code/.env
#
# Process environment variables take precedence over this file. The legacy
# ~/.mini-code/settings.json format remains a fallback. A target workspace's
# ordinary .env file is never used for primary-model credentials or routing.
# =============================================================================

# --- Primary model: choose exactly one provider profile ---
MINI_CODE_MODEL=claude-sonnet-4-20250514
MINI_CODE_PROVIDER=anthropic

# Anthropic profile
# ANTHROPIC_API_KEY=replace-me
# Or use auth token instead:
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI profile
# MINI_CODE_MODEL=gpt-4o
# MINI_CODE_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com

# OpenRouter profile (access to vendor/model IDs)
# MINI_CODE_MODEL=anthropic/claude-sonnet-4
# MINI_CODE_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api

# Custom OpenAI-compatible profile (DeepSeek, vLLM, Ollama, LiteLLM, etc.)
# MINI_CODE_MODEL=deepseek-chat
# MINI_CODE_PROVIDER=custom
# CUSTOM_API_KEY=...
# CUSTOM_API_BASE_URL=https://api.deepseek.com
# Local HTTP is accepted only for loopback endpoints, for example:
# CUSTOM_API_BASE_URL=http://127.0.0.1:11434/v1
# Configuration validation still requires a non-empty CUSTOM_API_KEY; for a
# loopback server that ignores authentication, use a harmless local-only value.

# --- Compatibility alias ---
# ANTHROPIC_MODEL remains supported as a legacy alias.
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- OpenRouter settings ---
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# OPENROUTER_REFERER=https://github.com/minicode-py
# OPENROUTER_TITLE=MiniCode Python
# OPENROUTER_TRANSFORMS=

# --- Custom endpoint settings ---
# CUSTOM_API_BASE_URL=http://localhost:11434/v1
# CUSTOM_API_KEY=
# CUSTOM_API_EXTRA_HEADERS=X-Custom-Header:value

# --- Skill discovery (main-model selection, default) ---
# Compact catalogs show all Skill descriptions; larger catalogs show directory
# cards and let the main model browse/search, compare descriptions, and load.
# Set routed explicitly to use the legacy relevance router instead.
# MINI_CODE_SKILL_SELECTION_MODE=model
# MINI_CODE_SKILL_FLAT_CATALOG_CHARS=8000
# MINI_CODE_SKILL_PAGE_CHARS=4000
# Intent hints and speculative directory prefetch remain opt-in experiments.
# MINI_CODE_SKILL_INTENT_HINTS=false
# MINI_CODE_SKILL_INTENT_PREFETCH=false

# --- Legacy routed Skill selection (embedding) ---
# 语义技能路由的 embedding 配置。默认指向 Qwen/DashScope compatible-mode，
# 任何 OpenAI 兼容的 /embeddings 端点都可用。
# 留空 MINICODE_EMBEDDING_API_KEY 即关闭（本地中英别名匹配仍然工作）。
# 读取顺序：进程环境变量 > ~/.mini-code/.env > 默认值。
# 为防止不受信任的项目重定向全局凭证，workspace .env 不参与远程 embedding 配置。
MINICODE_EMBEDDING_API_KEY=
MINICODE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen embedding 模型：text-embedding-v3 / text-embedding-v4
MINICODE_EMBEDDING_MODEL=text-embedding-v3
# MINICODE_EMBEDDING_TIMEOUT_SECONDS=10
# 相似度阈值（已按 Qwen text-embedding-v3 实测校准：相关 0.63-0.84，无关 <=0.48）。
# 换其他 embedding provider 时按其分布调整。
# MINICODE_EMBEDDING_SIGNAL_THRESHOLD=0.60
# MINICODE_EMBEDDING_SIGNAL_THRESHOLD_UNKNOWN=0.67
# MINICODE_EMBEDDING_BOOST_THRESHOLD=0.52

# --- Evidence-gated Hybrid Memory retrieval ---
# Disabled by default. local-e5 keeps query/memory embeddings on-device, but
# the remote verifier/challenger still receives the query plus candidate
# Memory text/metadata. qwen additionally sends query/approved Memory text to
# the Skill embedding endpoint and therefore requires separate authorization.
# MINI_CODE_MEMORY_HYBRID_ENABLED=false
# MINI_CODE_MEMORY_HYBRID_EMBEDDING_PROVIDER=local-e5
# MINI_CODE_ALLOW_REMOTE_MEMORY_EMBEDDING=false
# MINI_CODE_MEMORY_HYBRID_MODEL_PATH=/absolute/path/to/multilingual-e5-small
# MINI_CODE_MEMORY_HYBRID_EVIDENCE_PATH=/absolute/path/to/promotion-evidence.json
# MINI_CODE_MEMORY_HYBRID_VERIFIER_MODEL=deepseek-chat

# --- Post-task Memory contribution review ---
# After each task, adjudicate whether the memories actually injected helped,
# were refuted, or cannot be judged, by reading the prompt receipt against the
# sanitized tool-event trace. rule (default) uses only deterministic
# path-claim/tool-event binding (no extra model calls); llm additionally uses
# the structured side-call for ambiguous cases; off disables the review.
# Verdicts below MIN confidence are never scored, and every helped/invalidated
# verdict must cite real memory text plus real trace events.
# MINI_CODE_MEMORY_CONTRIBUTION_REVIEW=rule
# MINI_CODE_MEMORY_CONTRIBUTION_REVIEW_MIN_CONFIDENCE=0.6
# MINI_CODE_MEMORY_CONTRIBUTION_REVIEW_TIMEOUT_SECONDS=15
# The certified verifier route is isolated from the primary model. When the
# primary route is not DeepSeek, fill these dedicated credentials explicitly:
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# A primary DeepSeek custom route may reuse CUSTOM_API_KEY only when its model
# and endpoint are both the official DeepSeek route; other custom credentials
# are never lent to the verifier.

# --- User Profile ---
# Set response language and verbosity (also configurable via USER.md)
# MINI_CODE_LANGUAGE=zh-CN
# MINI_CODE_VERBOSITY=normal
# Options for VERBOSITY: concise, normal, detailed
# Create ~/.mini-code/USER.md for full profile customization

# --- Shared Agent Turn budget (top-level + all task sub-agents) ---
# The same token/model-call/cost counters are shared by the parent loop and
# every nested explore/plan/general sub-agent, including parallel read-only
# sub-agents. A general subprocess receives an atomically reserved finite
# lease; if it is hard-killed without valid usage, that lease is charged
# conservatively. Defaults (3,000,000 tokens / 150 model calls / USD 5.00)
# cover one whole-repository explore survey plus a workflow chain.
# MINI_CODE_TURN_BUDGET_TOKENS=2000000
# MINI_CODE_TURN_BUDGET_MODEL_CALLS=80
# MINI_CODE_TURN_BUDGET_COST_USD=20

# --- Workflow verifier: user-registered trusted executables ---
# Automatic trust discovery only accepts root-owned binaries on the system
# PATH (e.g. /usr/bin/python3), which usually lacks your project toolchain.
# Register conda/venv executables here to let deterministic verification run
# them inside the sandbox (read access to the toolchain prefix is granted;
# network stays denied, writes stay confined to the workspace):
# MINI_CODE_VERIFIER_TRUSTED_EXECUTABLES=pytest=/Users/you/venv/bin/pytest,python3=/Users/you/venv/bin/python3
# The host permission manager must still approve the exact command signature
# (allowedCommandPatterns in ~/.mini-code/permissions.json), so both the
# user-registered executable and the per-signature approval are required.

# --- Parent small-diff direct-edit fast path ---
# Low-risk bounded edits (<=4 non-sensitive workspace files, <=200 changed
# lines per diff, <=400 per turn) may be made directly by the parent agent;
# exceeding any bound escalates to the workflow route. Set 0 to require
# approval (or pre-authorized edit patterns) for every edit.
# MINI_CODE_PARENT_FAST_EDIT=1

# --- Workflow workspace digests ---
# Tree digests are cached per file keyed by (path, size, mtime_ns) — the same
# stat identity git's index uses — so a workflow's ~10 digest walks stop
# re-reading unchanged bytes (copies preserve mtime). Set to 0 to restore
# always-rehash behavior on filesystems with coarse timestamps.
# MINI_CODE_WORKSPACE_DIGEST_CACHE=1

# --- Context-aware semantic intent fallback (opt-in) ---
# Deterministic rules and bounded conversation context remain the fast path.
# For an unresolved request or one eligible uncovered clause, the fallback may
# make one bounded, tool-free call to the configured primary model. It shares the
# Agent Turn budget and telemetry, keeps at least one call for normal Agent
# execution, and never grants explicit Skill/tool/permission authority.
# Enabling it sends the current request plus bounded user/assistant context to
# that model provider. It is therefore disabled by default.
# MINI_CODE_INTENT_SEMANTIC_ENABLED=false
# MINI_CODE_INTENT_SEMANTIC_TIMEOUT_SECONDS=5.0
# MINI_CODE_INTENT_SEMANTIC_MIN_CONFIDENCE=0.72
# MINI_CODE_INTENT_SEMANTIC_MAX_INPUT_CHARS=4000
# MINI_CODE_INTENT_SEMANTIC_MAX_OUTPUT_BYTES=4096
# MINI_CODE_INTENT_SEMANTIC_MAX_OUTPUT_TOKENS=512
# Applied only when the configured adapter advertises the audited capability.
# JSON object output still requires local schema validation.
# MINI_CODE_INTENT_SEMANTIC_JSON_MODE=true
# MINI_CODE_INTENT_SEMANTIC_REASONING_EFFORT=low
# MINI_CODE_INTENT_SEMANTIC_RESERVE_MODEL_CALLS=1
# Optional versioned calibration JSON fitted offline from corrected outcomes.
# External artifacts are experimental and rejected unless the second flag is
# explicitly enabled. When omitted, the conservative built-in mapping is used.
# MINI_CODE_INTENT_SEMANTIC_CALIBRATION_PATH=/absolute/path/to/calibration.json
# MINI_CODE_INTENT_SEMANTIC_ALLOW_UNREVIEWED_CALIBRATION=false

# --- Native-schema Skill candidate reranker (opt-in, remote only) ---
# The deterministic router first builds a bounded candidate-ID allowlist. When
# enabled, an official OpenAI adapter with native strict JSON Schema support may
# reorder or abstain from only that allowlist. It cannot invent a Skill, revive
# a denied Skill, grant tool authority, or remove an explicitly requested Skill.
# The call shares the Agent Turn budget/telemetry and is skipped on unsupported
# providers, insufficient budget, timeout, or invalid structured output.
# Enabling it sends the current request and bounded Skill descriptions to the
# configured primary model provider. No local model is downloaded or executed.
# MINI_CODE_SKILL_RERANKER_ENABLED=false
# MINI_CODE_SKILL_RERANKER_TIMEOUT_SECONDS=1.5
# MINI_CODE_SKILL_RERANKER_MIN_CONFIDENCE=0.80
# MINI_CODE_SKILL_RERANKER_MAX_CANDIDATES=8
# MINI_CODE_SKILL_RERANKER_MAX_INPUT_CHARS=6000
# MINI_CODE_SKILL_RERANKER_MAX_OUTPUT_BYTES=2048
# MINI_CODE_SKILL_RERANKER_MAX_OUTPUT_TOKENS=128
# MINI_CODE_SKILL_RERANKER_RESERVE_MODEL_CALLS=1

# --- Dedicated per-agent model routing ---
# Fill only this key to route task sub-agents to DashScope Qwen automatically.
# When it is empty, sub-agents keep using the parent model for compatibility.
# The credential is deliberately separate from parent and embedding API keys.
# qwen3.6-flash is an illustrative configurable route. The checked-in public
# live-acceptance projection covers qwen3.7-plus/max, not this example model.
MINI_CODE_SUBAGENT_API_KEY=
MINI_CODE_SUBAGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MINI_CODE_SUBAGENT_MODEL=qwen3.6-flash
# Optional explicit switch and per-agent overrides:
# MINI_CODE_SUBAGENT_ROUTING_ENABLED=true
# MINI_CODE_SUBAGENT_PROVIDER=openai-compatible
# MINI_CODE_SUBAGENT_EXPLORE_MODEL=qwen3.6-flash
# MINI_CODE_SUBAGENT_PLAN_MODEL=qwen3.6-flash
# MINI_CODE_SUBAGENT_GENERAL_MODEL=qwen3.6-flash
# Optional per-agent model-turn limits (defaults 12/8/15; invalid values are
# ignored and the default applies). A sub-agent that reaches its limit
# soft-lands: one tool-free closing turn returns a partial summary instead of
# a hard failure.
# MINI_CODE_SUBAGENT_EXPLORE_MAX_TURNS=12
# MINI_CODE_SUBAGENT_PLAN_MAX_TURNS=8
# MINI_CODE_SUBAGENT_GENERAL_MAX_TURNS=15

# --- Recovery lesson Agent shadow (opt-in) ---
# Run a tool-free learner on bounded recovery episodes after rule memory is
# committed. Requires llm_shadow mode and the existing reflection provider
# permission; outputs remain comparison diagnostics and cannot become memory.
# MINI_CODE_RECOVERY_LESSON_SHADOW_ENABLED=false
# Maximum additional episode model calls per task (1..10, default 2).
# Shares the turn budget, deadline, sampling, and metrics bounds with reflection.
# MINI_CODE_RECOVERY_LESSON_MAX_CALLS=2
