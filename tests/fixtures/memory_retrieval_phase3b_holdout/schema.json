{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minicode.local/schemas/memory-retrieval-phase3b-holdout-v1.json",
  "title": "MiniCode Retrieval Phase 3B independent holdout",
  "oneOf": [
    {"$ref": "#/$defs/caseDocument"},
    {"$ref": "#/$defs/backgroundDocument"},
    {"$ref": "#/$defs/manifest"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^p3b-[a-z0-9-]+$"},
    "idList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "stringList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 160}},
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "category", "content", "tags", "domains", "tier", "lifecycle_status", "safety_status", "approval_status", "curator_locked", "created_at", "updated_at", "usefulness_score", "source", "metadata", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "scope": {"enum": ["user", "project", "local"]},
        "category": {"type": "string", "minLength": 3, "maxLength": 80},
        "content": {"type": "string", "minLength": 8, "maxLength": 2000},
        "tags": {"$ref": "#/$defs/stringList"},
        "domains": {"$ref": "#/$defs/stringList"},
        "tier": {"enum": ["working", "short_term", "long_term", "archival"]},
        "lifecycle_status": {"enum": ["active", "deprecated", "rejected", "pending"]},
        "safety_status": {"enum": ["safe", "suspicious", "unsafe"]},
        "approval_status": {"enum": ["approved", "pending", "rejected"]},
        "curator_locked": {"type": "boolean"},
        "created_at": {"const": 1748736000},
        "updated_at": {"const": 1748822400},
        "usefulness_score": {"const": 0.0},
        "source": {"const": "phase3b_holdout_fixture"},
        "metadata": {"type": "object", "maxProperties": 12},
        "provenance": {"type": "object", "maxProperties": 8}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "split", "polarity", "category", "query", "current_files", "active_domains", "context_usage", "query_language", "memory_language", "expected_scope", "semantic_relation_type", "memories", "primary_entry_ids", "must_exclude_ids", "expected_no_match", "allow_wide_candidate", "query_is_sufficient", "structured_metadata_complete", "normalized_token_overlap", "lexical_overlap_class", "annotation_evidence", "why_relevant_or_contrast", "miss_or_false_match_impact"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "split": {"const": "independent_holdout"},
        "polarity": {"enum": ["positive", "hard_negative"]},
        "category": {"type": "string", "minLength": 3, "maxLength": 80},
        "query": {"type": "string", "minLength": 8, "maxLength": 600},
        "current_files": {"$ref": "#/$defs/stringList"},
        "active_domains": {"$ref": "#/$defs/stringList"},
        "context_usage": {"type": "number", "minimum": 0, "maximum": 1},
        "query_language": {"enum": ["en", "zh"]},
        "memory_language": {"enum": ["en", "zh"]},
        "expected_scope": {"oneOf": [{"enum": ["user", "project", "local"]}, {"type": "null"}]},
        "semantic_relation_type": {"type": "string", "minLength": 3, "maxLength": 80},
        "memories": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/memory"}},
        "primary_entry_ids": {"$ref": "#/$defs/idList"},
        "must_exclude_ids": {"$ref": "#/$defs/idList"},
        "expected_no_match": {"type": "boolean"},
        "allow_wide_candidate": {"type": "boolean"},
        "query_is_sufficient": {"type": "boolean"},
        "structured_metadata_complete": {"type": "boolean"},
        "normalized_token_overlap": {"type": "number", "minimum": 0, "maximum": 1},
        "lexical_overlap_class": {"enum": ["zero", "low", "medium", "high"]},
        "annotation_evidence": {"type": "string", "minLength": 12, "maxLength": 500},
        "why_relevant_or_contrast": {"type": "string", "minLength": 12, "maxLength": 500},
        "miss_or_false_match_impact": {"type": "string", "minLength": 8, "maxLength": 300}
      }
    },
    "caseDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "document_type", "synthetic_data", "reference_time", "cases"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "document_type": {"const": "cases"},
        "synthetic_data": {"const": true},
        "reference_time": {"const": 1748826000},
        "cases": {"type": "array", "minItems": 60, "maxItems": 60, "items": {"$ref": "#/$defs/case"}}
      }
    },
    "backgroundDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "document_type", "synthetic_data", "reference_time", "pool_id", "memories"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "document_type": {"const": "background"},
        "synthetic_data": {"const": true},
        "reference_time": {"const": 1748826000},
        "pool_id": {"const": "phase3b-independent-pressure-v1"},
        "memories": {"type": "array", "minItems": 64, "maxItems": 64, "items": {"$ref": "#/$defs/memory"}}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "document_type", "dataset_id", "synthetic_data", "case_count", "positive_count", "hard_negative_count", "positive_categories", "negative_categories", "case_file", "background_file", "calibration_allowed", "first_hybrid_run"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "document_type": {"const": "manifest"},
        "dataset_id": {"const": "memory-retrieval-phase3b-holdout-v1"},
        "synthetic_data": {"const": true},
        "case_count": {"const": 60},
        "positive_count": {"const": 36},
        "hard_negative_count": {"const": 24},
        "positive_categories": {"type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true, "items": {"type": "string"}},
        "negative_categories": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"type": "string"}},
        "case_file": {"const": "cases.json"},
        "background_file": {"const": "background.json"},
        "calibration_allowed": {"const": false},
        "first_hybrid_run": {"const": false}
      }
    }
  }
}
