      "case_id": "error-same-call-two-sources-001",
      "category": "error_deduplication",
      "description": "Failed tool result and error event from one call are one logical error",
      "task_description": "Run the auth regression test",
      "trace": [
        {"event_id": "event-1", "call_id": "call-1", "type": "tool_call", "tool_name": "run_command", "input": {"command": "pytest tests/test_auth.py -q"}},
        {"event_id": "event-2", "call_id": "call-1", "type": "tool_result", "tool_name": "run_command", "status": "error", "is_error": true, "output_summary": "Expired token was accepted"},
        {"event_id": "event-3", "call_id": "call-1", "type": "error", "tool_name": "run_command", "error_type": "AssertionError", "message": "Expired token was accepted"},
        {"event_id": "event-4", "type": "task_result", "status": "failed"}
      ],
      "expected_evidence": {"files_read": [], "files_changed": [], "tools": ["run_command"], "libraries": [], "errors": [{"error_id": "error-1", "call_id": "call-1", "tool_name": "run_command", "error_type": "AssertionError", "message_key": "expired_token_accepted", "required_terms": ["expired token", "accepted"], "source_event_ids": ["event-2", "event-3"]}], "recoveries": [], "decisions": [], "verification": [{"verification_id": "verify-1", "result": "failed", "required_terms": ["expired token", "accepted"], "evidence_ids": ["event-1", "event-2"]}], "outcome": "failed"},
      "expected_value": {"should_write_memory": true, "reasons": ["reusable_failure_pattern"]},
      "expected_claims": [{"claim_id": "claim-1", "claim_type": "failure", "semantic_key": "expired_token_accepted", "evidence_ids": ["event-2", "event-3"], "epistemic_status": "confirmed", "required_terms": ["expired token", "accepted"], "forbidden_terms": []}],
      "forbidden_claims": [],
      "notes": "Current engine emits two error strings for this one logical failure."
    },
