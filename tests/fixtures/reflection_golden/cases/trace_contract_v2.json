      "expected_evidence": {"files_read": [], "files_changed": ["src/parser.py"], "tools": ["run_command", "edit_file"], "libraries": [], "errors": [{"error_id": "error-1", "call_id": "call-1", "tool_name": "run_command", "error_type": "AssertionError", "required_terms": ["wrong token"], "source_event_ids": ["event-000001"]}], "recoveries": [{"recovery_id": "recovery-1", "error_id": "error-1", "required_terms": ["corrected", "normalization"], "evidence_ids": ["event-000002"]}], "decisions": [], "verification": [{"verification_id": "verify-1", "result": "passed", "scope": "targeted", "required_terms": ["7 passed"], "evidence_ids": ["event-000003", "event-000004"]}], "outcome": "success"},
      "expected_value": {"should_write_memory": true, "reasons": ["verified_reusable_fix"]},
