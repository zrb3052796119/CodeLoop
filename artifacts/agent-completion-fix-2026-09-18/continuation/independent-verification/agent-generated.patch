+def _build_pytest_command(
+    target: Path,
+    test_files: list[Path],
+    verbose: bool,
+    coverage: bool,
+    pattern: str | None,
+) -> tuple[list[str], bool]:
+    """Build the pytest command.
+
+    Returns (command, collected_via_directory). Every discovered file must be
+    executed: silently truncating the list (formerly capped at 10 files) made
+    the tool report false passes on directories whose failing tests lived in
+    the dropped files. When the enumeration would grow unwieldy, fall back to
+    letting pytest collect the directory itself.
+    """
+    cmd = [sys.executable, "-m", "pytest"]
+
+    if target.is_dir() and len(test_files) > _MAX_EXPLICIT_TEST_FILES:
+        cmd.append(str(target))
+        return cmd, True
+
+    cmd.extend([str(f) for f in test_files])
+
+    if verbose:
+        cmd.append("-v")
+
+    if coverage:
+        cmd.extend(["--cov", str(target)])
+
+    if pattern:
+        cmd.extend(["-k", pattern])
+
+    return cmd, False
+
