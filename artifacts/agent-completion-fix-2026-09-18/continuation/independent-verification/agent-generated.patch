+def test_test_runner_runs_every_discovered_file_beyond_ten(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """test_runner used to cap the pytest command at the first 10 discovered
+    files, silently skipping the rest and reporting false passes on
+    directories whose failing tests lived in the dropped files."""
+    for i in range(1, 12):
+        (tmp_path / f"test_mod_{i:02d}.py").write_text(
+            "def test_ok():\n    assert True\n",
+            encoding="utf-8",
+        )
+    (tmp_path / "test_mod_12.py").write_text(
+        "def test_broken():\n    assert 1 == 2\n",
+        encoding="utf-8",
+    )
+
+    captured: dict[str, list[str]] = {}
+
+    def fake_run(cmd, **_kwargs):
+        captured["cmd"] = list(cmd)
+        return SimpleNamespace(returncode=0, stdout="10 passed", stderr="")
+
+    monkeypatch.setattr(test_runner_module.subprocess, "run", fake_run)
+
+    result = test_runner_tool.run(
+        {
+            "path": ".",
+            "framework": "pytest",
+            "verbose": False,
+            "coverage": False,
+            "pattern": None,
+            "timeout": 30,
+        },
+        ToolContext(cwd=str(tmp_path), permissions=None),
+    )
+
+    command_files = [arg for arg in captured["cmd"] if arg.endswith(".py")]
+    discovered = sorted(p.name for p in tmp_path.glob("test_mod_*.py"))
+    executed = sorted(Path(f).name for f in command_files)
+    assert executed == discovered, "every discovered test file must be executed"
+    assert any(f.endswith("test_mod_12.py") for f in command_files)
+    assert f"Test files executed: {len(discovered)}" in result.output
+
+
+def test_test_runner_reports_failure_in_file_beyond_ten(
+    tmp_path: Path,
+) -> None:
+    """End-to-end false-pass regression: 12 test files where the last one
+    (dropped by the old 10-file cap) contains a failing test."""
+    for i in range(1, 12):
+        (tmp_path / f"test_mod_{i:02d}.py").write_text(
+            "def test_ok():\n    assert True\n",
+            encoding="utf-8",
+        )
+    (tmp_path / "test_mod_12.py").write_text(
+        "def test_broken():\n    assert 1 == 2\n",
+        encoding="utf-8",
+    )
+
+    result = test_runner_tool.run(
+        {
+            "path": ".",
+            "framework": "pytest",
+            "verbose": False,
+            "coverage": False,
+            "pattern": None,
+            "timeout": 120,
+        },
+        ToolContext(cwd=str(tmp_path), permissions=None),
+    )
+
+    assert result.ok is False
+    assert "✗ Failed:  1" in result.output
+    assert "test_broken" in result.output
+    assert result.verification == {
+        "verificationVersion": 1,
+        "kind": "tests",
+        "outcome": "failed",
+        "source": "test_runner",
+    }
+
+
+def test_test_runner_never_reports_pass_when_output_reports_failures(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A zero exit code with failures in the output must not count as a pass."""
+    (tmp_path / "test_sample.py").write_text(
+        "def test_sample():\n    assert True\n",
+        encoding="utf-8",
+    )
+    monkeypatch.setattr(
+        test_runner_module.subprocess,
+        "run",
+        lambda *_args, **_kwargs: SimpleNamespace(
+            returncode=0,
+            stdout="3 passed, 1 failed",
+            stderr="",
+        ),
+    )
+
+    result = test_runner_tool.run(
+        {
+            "path": ".",
+            "framework": "pytest",
+            "verbose": False,
+            "coverage": False,
+            "pattern": None,
+            "timeout": 30,
+        },
+        ToolContext(cwd=str(tmp_path), permissions=None),
+    )
+
+    assert result.ok is False
+    assert result.verification == {
+        "verificationVersion": 1,
+        "kind": "tests",
+        "outcome": "failed",
+        "source": "test_runner",
+    }
+
