 _INVALID_ARGUMENT_RE = re.compile(
     r"(?i)(?:unrecognized (?:arguments?|options?)\s*:?\s*(.+)"
     r"|unknown (?:option|argument)\s*[:'\"]?\s*['\"]?(-{1,2}[\w-]+))"
