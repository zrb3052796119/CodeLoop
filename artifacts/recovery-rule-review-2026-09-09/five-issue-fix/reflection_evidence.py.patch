+    r"\bcollected\s+\d+\s+items?\b|Captured\s+(?:stderr|stdout)|"
+    r"Traceback \(most recent call last\)|^\s*(?:FAILED|ERROR)\s+\S+::|"
+    r"^\s*={2,}\s*FAILURES|\bin test_[\w]+)"
