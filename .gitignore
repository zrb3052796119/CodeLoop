# MiniCode specific. Runtime indexes/version state stay local, while project
# Skill source and project agent profiles are configuration and must survive
# a clean checkout.
.mini-code/*
!.mini-code/skills/
!.mini-code/skills/**
.mini-code/skills/**/.DS_Store
!.mini-code/agents/
!.mini-code/agents/**
.mini-code/agents/**/.DS_Store
.minicode-memory-authority.lock
minicode_session/
# Project-local / session runtime state is never versioned by design.
# Durable project Memory is useful at runtime but may contain private paths,
# prompts, or lessons, so .mini-code-memory/ also remains local.
.mini-code-memory-local/
.mini-code-session-memory/

