# Raw acceptance runs contain journals, temporary workspaces and local state.
# Commit only curated manifests, summaries, tables and figures.
/artifacts/**/*-evidence/
/artifacts/**/journal/
/artifacts/**/workspace/
/artifacts/**/memory-store.lock

# One-off development smokes are local diagnostics, not frozen acceptance
# evidence. Curated acceptance manifests and results remain allowlisted by
# their explicit paths in the repository.
/artifacts/persistent-memory-repair-acceptance-v3/strong-attribution-smoke.json
/artifacts/persistent-memory-repair-after-root-causes-smoke*/
/artifacts/persistent-memory-repair-code-pattern-smoke*/
